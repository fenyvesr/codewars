{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build C++ Release",
      "type": "shell",
      "windows": {
        "command": ".\\build.bat Release"
      },
      "options": {
        "cwd": "${workspaceFolder}/C++"
      },
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build C++ Debug",
      "type": "shell",
      "windows": {
        "command": ".\\build.bat Debug"
      },
      "options": {
        "cwd": "${workspaceFolder}/C++"
      },
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean build C++ Debug",
      "type": "shell",
      "windows": {
        "command": ".\\build.bat Debug clean"
      },
      "options": {
        "cwd": "${workspaceFolder}/C++"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}